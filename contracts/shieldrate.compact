// ShieldRate — Proof Integrity v1
// Compact language 0.22–0.23 / toolchain 0.31.x target.
//
// Integrity properties:
// - issuer authenticity is verified in-circuit with a Schnorr attestation;
// - arbitrary threshold probing is rejected by fixed policy bands;
// - holder identity is scoped to employer + job;
// - requests are challenge-bound and replay-protected;
// - successful receipts are keyed by verification id, never a stable holder id;
// - credential expiry and provider-epoch revocation are enforced;
// - failed predicates abort before any receipt is written.
//
// Important: request wall-clock expiry is also enforced by the DApp/verifier.
// Compact v0.23 does not expose a trusted wall-clock primitive here, so the
// receipt carries the bound expiry for independent verifier rejection.

pragma language_version >= 0.22 && <= 0.23;

import CompactStandardLibrary;
import "schnorr" prefix Schnorr_;

export { Schnorr_SchnorrSignature };

export struct PrivateCredential {
  income: Uint<64>;
  ratingX100: Uint<16>;
  completedJobs: Uint<32>;
  issuedAtEpoch: Uint<64>;
  expiresAtEpoch: Uint<64>;
  providerEpoch: Uint<64>;
}

export struct VerificationReceipt {
  requestHash: Bytes<32>;
  scopedSubject: Bytes<32>;
  providerId: Uint<16>;
  claimCode: Uint<8>;
  threshold: Uint<64>;
  requestExpiresAtEpoch: Uint<64>;
}

export new type HolderSecret = Bytes<32>;
export new type AdminSecret = Bytes<32>;
export new type AdminPublicKey = Bytes<32>;

constructor() {
  contractAdmin = disclose(deriveAdminPublicKey(getAdminSecret()));
}

export ledger contractAdmin: AdminPublicKey;
export ledger providers: Map<Uint<16>, JubjubPoint>;
export ledger providerEpochs: Map<Uint<16>, Uint<64>>;
export ledger usedNullifiers: Set<Bytes<32>>;
export ledger receipts: Map<Bytes<32>, VerificationReceipt>;
export ledger totalVerified: Counter;

witness getAttestedCredential(): [PrivateCredential, Schnorr_SchnorrSignature, Uint<16>];
witness getHolderSecret(): HolderSecret;
witness getAdminSecret(): AdminSecret;

export pure circuit deriveAdminPublicKey(secret: AdminSecret): AdminPublicKey {
  return persistentHash<[Bytes<23>, AdminSecret]>([
    "shieldrate:admin:key:v1",
    secret
  ]) as AdminPublicKey;
}

export pure circuit deriveHolderBinding(secret: HolderSecret): Bytes<32> {
  return persistentHash<[Bytes<28>, HolderSecret]>([
    "shieldrate:holder:binding:v1",
    secret
  ]);
}

export pure circuit deriveScopedSubject(
  secret: HolderSecret,
  employerScope: Bytes<32>,
  jobScope: Bytes<32>
): Bytes<32> {
  return persistentHash<[Bytes<21>, Bytes<32>, Bytes<32>, HolderSecret]>([
    "shieldrate:subject:v1",
    employerScope,
    jobScope,
    secret
  ]);
}

export pure circuit deriveRequestHash(
  employerScope: Bytes<32>,
  jobScope: Bytes<32>,
  claimCode: Uint<8>,
  threshold: Uint<64>,
  challenge: Bytes<32>,
  requestExpiresAtEpoch: Uint<64>
): Bytes<32> {
  return persistentHash<[
    Bytes<21>,
    Bytes<32>,
    Bytes<32>,
    Uint<8>,
    Uint<64>,
    Bytes<32>,
    Uint<64>
  ]>([
    "shieldrate:request:v1",
    employerScope,
    jobScope,
    claimCode,
    threshold,
    challenge,
    requestExpiresAtEpoch
  ]);
}

export pure circuit deriveNullifier(
  secret: HolderSecret,
  requestHash: Bytes<32>
): Bytes<32> {
  return persistentHash<[Bytes<23>, Bytes<32>, HolderSecret]>([
    "shieldrate:nullifier:v1",
    requestHash,
    secret
  ]);
}

export pure circuit deriveVerificationId(
  requestHash: Bytes<32>,
  scopedSubject: Bytes<32>,
  nullifier: Bytes<32>
): Bytes<32> {
  return persistentHash<[Bytes<26>, Bytes<32>, Bytes<32>, Bytes<32>]>([
    "shieldrate:verification:v1",
    requestHash,
    scopedSubject,
    nullifier
  ]);
}

circuit assertAllowedPolicy(claimCode: Uint<8>, threshold: Uint<64>): [] {
  if (claimCode == 1) {
    assert(
      threshold == 40000 || threshold == 50000 || threshold == 80000 || threshold == 120000,
      "income threshold outside approved policy bands"
    );
  } else if (claimCode == 2) {
    assert(
      threshold == 400 || threshold == 450 || threshold == 490,
      "rating threshold outside approved policy bands"
    );
  } else {
    assert(claimCode == 3, "unknown claim code");
    assert(
      threshold == 50 || threshold == 100 || threshold == 200,
      "jobs threshold outside approved policy bands"
    );
  }
}

circuit assertAdmin(): [] {
  assert(
    contractAdmin == deriveAdminPublicKey(getAdminSecret()),
    "admin authorization failed"
  );
}

export circuit registerProvider(
  providerId: Uint<16>,
  providerPk: JubjubPoint
): [] {
  assertAdmin();
  providers.insert(disclose(providerId), disclose(providerPk));
  if (!providerEpochs.member(disclose(providerId))) {
    providerEpochs.insert(disclose(providerId), 0);
  }
}

// V1 revocation is provider-epoch based. Rotating the epoch invalidates all
// credentials previously signed by that provider without exposing a stable
// per-holder credential id during verification.
export circuit rotateProviderEpoch(providerId: Uint<16>): [] {
  assertAdmin();
  const id = disclose(providerId);
  assert(providerEpochs.member(id), "provider not registered");
  const currentEpoch = providerEpochs.lookup(id);
  assert(currentEpoch < 18446744073709551615, "provider epoch exhausted");
  providerEpochs.insert(id, currentEpoch + 1);
}

export circuit removeProvider(providerId: Uint<16>): [] {
  assertAdmin();
  const id = disclose(providerId);
  assert(providers.member(id), "provider not registered");
  providers.remove(id);
  if (providerEpochs.member(id)) {
    providerEpochs.remove(id);
  }
}

export circuit verifyClaim(
  employerScope: Bytes<32>,
  jobScope: Bytes<32>,
  claimCode: Uint<8>,
  threshold: Uint<64>,
  challenge: Bytes<32>,
  requestExpiresAtEpoch: Uint<64>
): Bytes<32> {
  assertAllowedPolicy(claimCode, threshold);

  const [credential, signature, providerId] = getAttestedCredential();
  const disclosedProviderId = disclose(providerId);
  assert(providers.member(disclosedProviderId), "attestation provider not registered");
  assert(providerEpochs.member(disclosedProviderId), "provider epoch unavailable");
  assert(
    credential.providerEpoch == providerEpochs.lookup(disclosedProviderId),
    "credential revoked by provider epoch rotation"
  );
  assert(
    credential.expiresAtEpoch >= requestExpiresAtEpoch,
    "credential expires before the verification request"
  );

  const holderSecret = getHolderSecret();
  const holderBinding = deriveHolderBinding(holderSecret);
  const holderBindingField = transientHash<Bytes<32>>(holderBinding);

  // The provider signs the private credential AND its holder binding. The
  // signature and raw fields remain private inside the ZK proof.
  const attestedMessage: Vector<7, Field> = [
    credential.income as Field,
    credential.ratingX100 as Field,
    credential.completedJobs as Field,
    credential.issuedAtEpoch as Field,
    credential.expiresAtEpoch as Field,
    credential.providerEpoch as Field,
    holderBindingField
  ];
  Schnorr_schnorrVerify<7>(
    attestedMessage,
    signature,
    providers.lookup(disclosedProviderId)
  );

  // A failed predicate aborts here. No negative result reaches the ledger.
  if (claimCode == 1) {
    assert(credential.income > threshold, "income threshold not met");
  } else if (claimCode == 2) {
    assert((credential.ratingX100 as Uint<64>) >= threshold, "rating threshold not met");
  } else {
    assert((credential.completedJobs as Uint<64>) >= threshold, "jobs threshold not met");
  }

  const requestHash = deriveRequestHash(
    employerScope,
    jobScope,
    claimCode,
    threshold,
    challenge,
    requestExpiresAtEpoch
  );
  const scopedSubject = deriveScopedSubject(holderSecret, employerScope, jobScope);
  const nullifier = deriveNullifier(holderSecret, requestHash);

  assert(!usedNullifiers.member(disclose(nullifier)), "request replay detected");

  const verificationId = deriveVerificationId(requestHash, scopedSubject, nullifier);
  usedNullifiers.insert(disclose(nullifier));
  receipts.insert(
    disclose(verificationId),
    disclose(VerificationReceipt {
      requestHash: requestHash,
      scopedSubject: scopedSubject,
      providerId: providerId,
      claimCode: claimCode,
      threshold: threshold,
      requestExpiresAtEpoch: requestExpiresAtEpoch
    })
  );
  totalVerified.increment(1);

  return disclose(verificationId);
}

export circuit receiptExists(verificationId: Bytes<32>): Boolean {
  return receipts.member(disclose(verificationId));
}
