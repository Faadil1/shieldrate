pragma language_version >= 0.22 && <= 0.23;

import CompactStandardLibrary;
import "schnorr" prefix Schnorr_;

export { Schnorr_SchnorrSignature };

export struct PrivateCredential {
  income: Uint<64>;
  ratingX100: Uint<16>;
  completedJobs: Uint<32>;
  issuedAtEpoch: Uint<64>;
  expiresAtEpoch: Uint<64>;
  providerEpoch: Uint<64>;
}

export struct VerificationReceipt {
  requestHash: Bytes<32>;
  scopedSubject: Bytes<32>;
  providerId: Uint<16>;
  claimCode: Uint<8>;
  threshold: Uint<64>;
  requestExpiresAtEpoch: Uint<64>;
}

export struct WorkRequest {
  employerPkh: Bytes<32>;
  jobScope: Bytes<32>;
  policyCode: Uint<16>;
  challenge: Bytes<32>;
  requestNonce: Bytes<32>;
  expiresAtEpoch: Uint<64>;
}

export struct WorkQualificationReceipt {
  workRequestId: Bytes<32>;
  scopedSubject: Bytes<32>;
  providerId: Uint<16>;
  policyCode: Uint<16>;
  requestExpiresAtEpoch: Uint<64>;
}

export new type HolderSecret = Bytes<32>;
export new type AdminSecret = Bytes<32>;
export new type AdminPublicKey = Bytes<32>;

constructor() {
  contractAdmin = disclose(deriveAdminPublicKey(getAdminSecret()));
}

export ledger contractAdmin: AdminPublicKey;
export ledger providers: Map<Uint<16>, JubjubPoint>;
export ledger providerEpochs: Map<Uint<16>, Uint<64>>;
export ledger usedNullifiers: Set<Bytes<32>>;
export ledger receipts: Map<Bytes<32>, VerificationReceipt>;
export ledger workRequests: Map<Bytes<32>, WorkRequest>;
export ledger jobRequests: Map<Bytes<32>, Bytes<32>>;
export ledger cancelledWorkRequests: Set<Bytes<32>>;
export ledger workReceipts: Map<Bytes<32>, WorkQualificationReceipt>;
export ledger totalVerified: Counter;
export ledger totalQualified: Counter;
export ledger totalWorkRequests: Counter;

witness getAttestedCredential(): [PrivateCredential, Schnorr_SchnorrSignature, Uint<16>];
witness getHolderSecret(): HolderSecret;
witness getAdminSecret(): AdminSecret;

export pure circuit deriveAdminPublicKey(secret: AdminSecret): AdminPublicKey {
  return persistentHash<[Bytes<23>, AdminSecret]>([
    "shieldrate:admin:key:v1",
    secret
  ]) as AdminPublicKey;
}

export pure circuit deriveHolderBinding(secret: HolderSecret): Bytes<32> {
  return persistentHash<[Bytes<28>, HolderSecret]>([
    "shieldrate:holder:binding:v1",
    secret
  ]);
}

export pure circuit deriveScopedSubject(
  secret: HolderSecret,
  employerScope: Bytes<32>,
  jobScope: Bytes<32>
): Bytes<32> {
  return persistentHash<[Bytes<21>, Bytes<32>, Bytes<32>, HolderSecret]>([
    "shieldrate:subject:v1",
    employerScope,
    jobScope,
    secret
  ]);
}

export pure circuit deriveRequestHash(
  employerScope: Bytes<32>,
  jobScope: Bytes<32>,
  claimCode: Uint<8>,
  threshold: Uint<64>,
  challenge: Bytes<32>,
  requestExpiresAtEpoch: Uint<64>
): Bytes<32> {
  return persistentHash<[
    Bytes<21>, Bytes<32>, Bytes<32>, Uint<8>, Uint<64>, Bytes<32>, Uint<64>
  ]>([
    "shieldrate:request:v1",
    employerScope,
    jobScope,
    claimCode,
    threshold,
    challenge,
    requestExpiresAtEpoch
  ]);
}

export pure circuit deriveNullifier(
  secret: HolderSecret,
  requestHash: Bytes<32>
): Bytes<32> {
  return persistentHash<[Bytes<23>, Bytes<32>, HolderSecret]>([
    "shieldrate:nullifier:v1",
    requestHash,
    secret
  ]);
}

export pure circuit deriveVerificationId(
  requestHash: Bytes<32>,
  scopedSubject: Bytes<32>,
  nullifier: Bytes<32>
): Bytes<32> {
  return persistentHash<[Bytes<26>, Bytes<32>, Bytes<32>, Bytes<32>]>([
    "shieldrate:verification:v1",
    requestHash,
    scopedSubject,
    nullifier
  ]);
}

export pure circuit deriveWorkRequestId(
  jobScope: Bytes<32>,
  policyCode: Uint<16>,
  challenge: Bytes<32>,
  requestNonce: Bytes<32>,
  requestExpiresAtEpoch: Uint<64>
): Bytes<32> {
  return persistentHash<[
    Bytes<26>, Bytes<32>, Uint<16>, Bytes<32>, Bytes<32>, Uint<64>
  ]>([
    "shieldrate:work-request:v2",
    jobScope,
    policyCode,
    challenge,
    requestNonce,
    requestExpiresAtEpoch
  ]);
}

export pure circuit deriveJobKey(
  employerPkh: Bytes<32>,
  jobScope: Bytes<32>
): Bytes<32> {
  return persistentHash<[Bytes<22>, Bytes<32>, Bytes<32>]>([
    "shieldrate:work-job:v1",
    employerPkh,
    jobScope
  ]);
}

export pure circuit deriveWorkPolicyNullifier(
  secret: HolderSecret,
  employerPkh: Bytes<32>,
  jobScope: Bytes<32>
): Bytes<32> {
  return persistentHash<[Bytes<28>, Bytes<32>, Bytes<32>, HolderSecret]>([
    "shieldrate:work-nullifier:v2",
    employerPkh,
    jobScope,
    secret
  ]);
}

export pure circuit deriveWorkPolicyVerificationId(
  workRequestId: Bytes<32>,
  scopedSubject: Bytes<32>,
  nullifier: Bytes<32>
): Bytes<32> {
  return persistentHash<[Bytes<31>, Bytes<32>, Bytes<32>, Bytes<32>]>([
    "shieldrate:work-verification:v2",
    workRequestId,
    scopedSubject,
    nullifier
  ]);
}

export pure circuit deriveIssuerChallenge(
  annX: Field,
  annY: Field,
  providerPkX: Field,
  providerPkY: Field,
  income: Uint<64>,
  ratingX100: Uint<16>,
  completedJobs: Uint<32>,
  issuedAtEpoch: Uint<64>,
  expiresAtEpoch: Uint<64>,
  providerEpoch: Uint<64>,
  holderBindingField: Field
): Field {
  return Schnorr_schnorrChallenge7(
    annX,
    annY,
    providerPkX,
    providerPkY,
    [
      income as Field,
      ratingX100 as Field,
      completedJobs as Field,
      issuedAtEpoch as Field,
      expiresAtEpoch as Field,
      providerEpoch as Field,
      holderBindingField
    ]
  );
}

export circuit callerPkh(): Bytes<32> {
  return persistentHash<ZswapCoinPublicKey>(ownPublicKey());
}

circuit assertAllowedPolicy(claimCode: Uint<8>, threshold: Uint<64>): [] {
  if (claimCode == 1) {
    assert(threshold == 40000 || threshold == 50000 || threshold == 80000 || threshold == 120000, "income threshold outside approved policy bands");
  } else if (claimCode == 2) {
    assert(threshold == 400 || threshold == 450 || threshold == 490, "rating threshold outside approved policy bands");
  } else {
    assert(claimCode == 3, "unknown claim code");
    assert(threshold == 50 || threshold == 100 || threshold == 200, "jobs threshold outside approved policy bands");
  }
}

circuit assertWorkPolicy(policyCode: Uint<16>, credential: PrivateCredential): [] {
  if (policyCode == 1) {
    assert(credential.income > 40000, "work qualification policy not satisfied");
    assert(credential.ratingX100 >= 400, "work qualification policy not satisfied");
    assert(credential.completedJobs >= 50, "work qualification policy not satisfied");
  } else if (policyCode == 2) {
    assert(credential.income > 50000, "work qualification policy not satisfied");
    assert(credential.ratingX100 >= 450, "work qualification policy not satisfied");
    assert(credential.completedJobs >= 100, "work qualification policy not satisfied");
  } else {
    assert(policyCode == 3, "unknown work qualification policy");
    assert(credential.income > 80000, "work qualification policy not satisfied");
    assert(credential.ratingX100 >= 490, "work qualification policy not satisfied");
    assert(credential.completedJobs >= 200, "work qualification policy not satisfied");
  }
}

circuit assertAdmin(): [] {
  assert(contractAdmin == deriveAdminPublicKey(getAdminSecret()), "admin authorization failed");
}

circuit assertCredential(providerId: Uint<16>, credential: PrivateCredential, signature: Schnorr_SchnorrSignature): [] {
  const disclosedProviderId = disclose(providerId);
  assert(providers.member(disclosedProviderId), "attestation provider not registered");
  assert(providerEpochs.member(disclosedProviderId), "provider epoch unavailable");
  assert(credential.providerEpoch == providerEpochs.lookup(disclosedProviderId), "credential revoked by provider epoch rotation");
  assert(blockTimeGte(disclose(credential.issuedAtEpoch)), "credential issuance is in the future");

  const holderSecret = getHolderSecret();
  const holderBinding = deriveHolderBinding(holderSecret);
  const holderBindingField = transientHash<Bytes<32>>(holderBinding);
  const attestedMessage: Vector<7, Field> = [
    credential.income as Field,
    credential.ratingX100 as Field,
    credential.completedJobs as Field,
    credential.issuedAtEpoch as Field,
    credential.expiresAtEpoch as Field,
    credential.providerEpoch as Field,
    holderBindingField
  ];
  Schnorr_schnorrVerify<7>(attestedMessage, signature, providers.lookup(disclosedProviderId));
}

export circuit registerProvider(providerId: Uint<16>, providerPk: JubjubPoint): [] {
  assertAdmin();
  const id = disclose(providerId);
  assert(!providers.member(id), "provider already registered");
  providers.insert(id, disclose(providerPk));
  if (!providerEpochs.member(id)) {
    providerEpochs.insert(id, 0);
  }
}

export circuit rotateProviderEpoch(providerId: Uint<16>): [] {
  assertAdmin();
  const id = disclose(providerId);
  assert(providers.member(id), "provider not active");
  assert(providerEpochs.member(id), "provider epoch unavailable");
  const currentEpoch = providerEpochs.lookup(id);
  assert(currentEpoch < 18446744073709551615, "provider epoch exhausted");
  providerEpochs.insert(id, (currentEpoch + 1) as Uint<64>);
}

export circuit removeProvider(providerId: Uint<16>): [] {
  assertAdmin();
  const id = disclose(providerId);
  assert(providers.member(id), "provider not registered");
  assert(providerEpochs.member(id), "provider epoch unavailable");
  const currentEpoch = providerEpochs.lookup(id);
  assert(currentEpoch < 18446744073709551615, "provider epoch exhausted");
  providers.remove(id);
  providerEpochs.insert(id, (currentEpoch + 1) as Uint<64>);
}

export circuit registerWorkRequest(
  jobScope: Bytes<32>,
  policyCode: Uint<16>,
  challenge: Bytes<32>,
  requestNonce: Bytes<32>,
  requestExpiresAtEpoch: Uint<64>
): Bytes<32> {
  assert(policyCode >= 1 && policyCode <= 3, "unknown work qualification policy");
  assert(blockTimeLt(disclose(requestExpiresAtEpoch)), "work request already expired");

  const employerPkh = callerPkh();
  const disclosedJobScope = disclose(jobScope);
  const jobKey = deriveJobKey(employerPkh, disclosedJobScope);
  assert(!jobRequests.member(jobKey), "qualification standard already fixed for this employer/job");

  const workRequestId = deriveWorkRequestId(
    disclosedJobScope,
    disclose(policyCode),
    disclose(challenge),
    disclose(requestNonce),
    disclose(requestExpiresAtEpoch)
  );
  assert(!workRequests.member(workRequestId), "work request already exists");

  workRequests.insert(workRequestId, WorkRequest {
    employerPkh: employerPkh,
    jobScope: disclosedJobScope,
    policyCode: disclose(policyCode),
    challenge: disclose(challenge),
    requestNonce: disclose(requestNonce),
    expiresAtEpoch: disclose(requestExpiresAtEpoch)
  });
  jobRequests.insert(jobKey, workRequestId);
  totalWorkRequests.increment(1);
  return disclose(workRequestId);
}

export circuit cancelWorkRequest(workRequestId: Bytes<32>): [] {
  const id = disclose(workRequestId);
  assert(workRequests.member(id), "unknown work request");
  assert(!cancelledWorkRequests.member(id), "work request already cancelled");
  const request = workRequests.lookup(id);
  assert(request.employerPkh == callerPkh(), "only the request employer may cancel");
  cancelledWorkRequests.insert(id);
}

export circuit verifyClaim(
  employerScope: Bytes<32>,
  jobScope: Bytes<32>,
  claimCode: Uint<8>,
  threshold: Uint<64>,
  challenge: Bytes<32>,
  requestExpiresAtEpoch: Uint<64>
): Bytes<32> {
  assertAllowedPolicy(claimCode, threshold);
  assert(blockTimeLt(disclose(requestExpiresAtEpoch)), "verification request expired");

  const [credential, signature, providerId] = getAttestedCredential();
  assertCredential(providerId, credential, signature);
  assert(credential.expiresAtEpoch >= requestExpiresAtEpoch, "credential expires before the verification request");

  if (claimCode == 1) {
    assert(credential.income > threshold, "income threshold not met");
  } else if (claimCode == 2) {
    assert((credential.ratingX100 as Uint<64>) >= threshold, "rating threshold not met");
  } else {
    assert((credential.completedJobs as Uint<64>) >= threshold, "jobs threshold not met");
  }

  const holderSecret = getHolderSecret();
  const requestHash = deriveRequestHash(employerScope, jobScope, claimCode, threshold, challenge, requestExpiresAtEpoch);
  const scopedSubject = deriveScopedSubject(holderSecret, employerScope, jobScope);
  const nullifier = deriveNullifier(holderSecret, requestHash);
  assert(!usedNullifiers.member(disclose(nullifier)), "request replay detected");

  const verificationId = deriveVerificationId(requestHash, scopedSubject, nullifier);
  usedNullifiers.insert(disclose(nullifier));
  receipts.insert(disclose(verificationId), disclose(VerificationReceipt {
    requestHash: requestHash,
    scopedSubject: scopedSubject,
    providerId: providerId,
    claimCode: claimCode,
    threshold: threshold,
    requestExpiresAtEpoch: requestExpiresAtEpoch
  }));
  totalVerified.increment(1);
  return disclose(verificationId);
}

export circuit verifyRegisteredWorkPolicy(workRequestId: Bytes<32>): Bytes<32> {
  const id = disclose(workRequestId);
  assert(workRequests.member(id), "unknown work request");
  assert(!cancelledWorkRequests.member(id), "work request cancelled");
  const request = workRequests.lookup(id);
  assert(blockTimeLt(request.expiresAtEpoch), "work request expired");

  const [credential, signature, providerId] = getAttestedCredential();
  assertCredential(providerId, credential, signature);
  assert(credential.expiresAtEpoch >= request.expiresAtEpoch, "credential expires before the work request");
  assertWorkPolicy(request.policyCode, credential);

  const holderSecret = getHolderSecret();
  const scopedSubject = deriveScopedSubject(holderSecret, request.employerPkh, request.jobScope);
  const nullifier = deriveWorkPolicyNullifier(holderSecret, request.employerPkh, request.jobScope);
  assert(!usedNullifiers.member(disclose(nullifier)), "qualification already proven for this opportunity");

  const verificationId = deriveWorkPolicyVerificationId(id, scopedSubject, nullifier);
  usedNullifiers.insert(disclose(nullifier));
  workReceipts.insert(disclose(verificationId), disclose(WorkQualificationReceipt {
    workRequestId: id,
    scopedSubject: scopedSubject,
    providerId: providerId,
    policyCode: request.policyCode,
    requestExpiresAtEpoch: request.expiresAtEpoch
  }));
  totalQualified.increment(1);
  return disclose(verificationId);
}

export circuit receiptExists(verificationId: Bytes<32>): Boolean {
  return receipts.member(disclose(verificationId));
}

export circuit workRequestExists(workRequestId: Bytes<32>): Boolean {
  return workRequests.member(disclose(workRequestId));
}

export circuit workReceiptExists(verificationId: Bytes<32>): Boolean {
  return workReceipts.member(disclose(verificationId));
}
