# Default remains the honest local integrity demo.
VITE_SHIELDRATE_MODE=demo-attested

# Set to midnight-live only after a contract is deployed and the issuer service
# is reachable. Do not put private keys or wallet secrets in Vite variables.
# VITE_SHIELDRATE_MODE=midnight-live
VITE_NETWORK_ID=preprod
VITE_SHIELDRATE_CONTRACT_ADDRESS=
VITE_SHIELDRATE_ATTESTATION_URL=
